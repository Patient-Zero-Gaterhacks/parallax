# Copy this file to .env and fill in what you need. Never commit .env.
# Everything here is optional; Parallax runs without any of it.

# Turns on the Gemma 4 check and the Gemma reader in the demo
GEMINI_API_KEY=

# Folder of a fine-tuned model from ml/train_transformer.py
PARALLAX_ML_TRANSFORMER=

# Set to 0 to turn off our fast trained model
PARALLAX_ML=1

# Set to 1 to let Gemma write the demo plans
PARALLAX_GEMMA_PLANNER=0

# Where the training/test datasets live (scripts/get_data.sh)
PARALLAX_DATA=../data_src

# Hugging Face token, only for downloading Gemma / datasets when training
HF_TOKEN=
